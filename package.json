{
  "name": "ai-news-triage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI news RSS triage board — fetch, filter, tag and clear your AI news inbox. Built with Kiro for the Kiro University Challenge.",
  "bin": {
    "newsdeck-mcp": "./mcp-server/index.mjs"
  },
  "files": [
    "mcp-server/",
    "server/data/snapshot.json"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "snapshot": "tsx server/snapshot.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "fast-check": "^4.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
